{
  "name": "fishrank",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev --prefix apps/web\" \"npm run dev --prefix apps/api\"",
    "dev:all": "node scripts/py.mjs scripts/kill_port.py 8000 && node scripts/py.mjs scripts/kill_port.py 8001 && concurrently -n web,api,ai -c blue,green,magenta \"npm run dev --prefix apps/web\" \"npm run dev --prefix apps/api\" \"npm run ai\"",
    "build": "npm run build --prefix apps/web && npm run build --prefix apps/api",
    "web": "npm run dev --prefix apps/web",
    "api": "npm run dev --prefix apps/api",
    "ai": "node scripts/py.mjs ai/run.py",
    "ai:stop": "node scripts/py.mjs scripts/kill_port.py 8001",
    "ai:restart": "node scripts/py.mjs scripts/kill_port.py 8001 && node scripts/py.mjs ai/run.py",
    "ai:install": "node scripts/py.mjs -m pip install -r ai/requirements.txt",
    "ai:sync-catalog": "npm exec --prefix apps/api -- ts-node prisma/export-ai-species-catalog.ts",
    "ai:crawl": "node scripts/py.mjs -u ai/training/crawl_images.py --core-only --mode classification --sources inat,gbif,commons --per-source 40 --skip-done 30 --workers 8",
    "ai:crawl:core": "node scripts/py.mjs -u ai/training/crawl_images.py --core-only --mode both --per-source 50 --sources inat,gbif,commons --workers 8",
    "ai:crawl:bulk": "node scripts/py.mjs -u ai/training/crawl_images.py --sources inat,gbif,commons --per-source 30 --skip-done 25 --workers 8 --species-workers 3",
    "ai:crawl:purge-bing": "node scripts/py.mjs ai/training/purge_bing_crawl.py",
    "ai:crawl:full": "node scripts/py.mjs -u ai/training/crawl_images.py --mode both --per-source 80 --skip-done 0 --sources inat,gbif,commons --workers 8",
    "ai:crawl:angling": "node scripts/py.mjs -u ai/training/crawl_images.py --angling-only --mode classification --sources inat,gbif,commons --per-source 35 --skip-done 25 --workers 8 --species-workers 2",
    "ai:pipeline:angling": "node scripts/py.mjs ai/training/build_dataset.py --angling-only && npm run ai:train && npm run ai:eval",
    "ai:pipeline:core": "node scripts/py.mjs ai/training/build_dataset.py --core-only && npm run ai:train && npm run ai:eval",
    "ai:crawl:quick": "node scripts/py.mjs ai/training/crawl_images.py --species ayu --per-source 10 --bing-per-query 5 --sources inat,gbif",
    "ai:dataset": "node scripts/py.mjs ai/training/build_dataset.py",
    "ai:train": "node scripts/py.mjs ai/training/train.py",
    "ai:eval": "node scripts/py.mjs ai/training/evaluate.py",
    "ai:pipeline": "npm run ai:dataset && npm run ai:train && npm run ai:eval",
    "ai:export-ruler": "npm exec --prefix apps/api -- ts-node prisma/export-ruler-dataset.ts",
    "ai:package:gpu": "node scripts/py.mjs ai/training/package_gpu_zip.py",
    "mobile": "node scripts/mobile-dev.mjs",
    "mobile:android": "node scripts/mobile-dev.mjs --android",
    "mobile:stop": "node scripts/mobile-stop.mjs",
    "db:up": "docker compose up -d postgres redis",
    "db:seed": "npm run seed --prefix apps/api",
    "postinstall": "npm run postinstall --prefix apps/api --if-present",
    "import:fish-species": "npm run import:fish-species --prefix apps/api",
    "export:ai-catalog": "npm run export:ai-catalog --prefix apps/api",
    "sync:fish-info": "npm run sync:fish-info --prefix apps/api"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "msgpackr-extract@3.0.4": true
  }
}
